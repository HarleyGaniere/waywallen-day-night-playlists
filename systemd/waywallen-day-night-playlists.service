[Unit]
Description=Switch Waywallen playlists between day (light theme) and night (dark theme)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Change "Day" and "Night" to your playlist names (or ids from: waywallen-day-night-playlists list)
ExecStart=/usr/local/bin/waywallen-day-night-playlists watch --light "Day" --dark "Night"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
