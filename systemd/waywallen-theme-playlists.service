[Unit]
Description=Switch Waywallen playlists with the light/dark theme
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Change "Day" and "Night" to your playlist names (or ids from: waywallen-theme-playlists list)
ExecStart=/usr/local/bin/waywallen-theme-playlists watch --light "Day" --dark "Night"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
